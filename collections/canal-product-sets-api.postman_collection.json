          "request": {
            "name": "product sets list",
            "description": {
              "content": "\nReturns a paginated list of product sets (IDs and lightweight metadata) for suppliers\nconnected to the authenticated store. Each result includes: product_set_id, supplier_id,\nname, description, type (e.g., MANUAL, RULE_BASED), created_at, updated_at.\n**Optional filters:** supplier_id (UUID), updated_since (ISO 8601).\nResults use cursor-based pagination, ordered by updated_at descending.\n",
              "type": "text/plain"
            },
