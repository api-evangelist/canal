                  "key": "cursor",
                  "value": "<string>",
                  "description": "The pagination cursor value."
                },
                {
                  "disabled": false,
                  "key": "supplier_id",
                  "value": "<uuid>",
                  "description": "Restrict results to product sets belonging to this supplier."
                },
                {
                  "disabled": false,
                  "key": "updated_since",
                  "value": "<dateTime>",
                  "description": "Returns only sets updated after this date (ISO 8601 format)."
                }
